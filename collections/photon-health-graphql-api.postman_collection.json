  "info": {
    "_postman_id": "6630093e-a5d0-4d1e-a881-909b5fd6fe89",
    "name": "Photon Health Clinical GraphQL API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Photon Health is a native GraphQL e-prescribing (eRx) platform. The entire Clinical API surface - patients, prescriptions, orders, the medication catalog, and pharmacies - is exposed through a single GraphQL endpoint at POST /graphql. This OpenAPI document models that single GraphQL transport operation; see graphql/photon-health-schema.graphql for the GraphQL schema and the documented queries and mutations.\n\nContact Support:\n Name: Photon Health Support",
      "type": "text/plain"
    }
